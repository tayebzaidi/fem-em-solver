# The one XL window scripts/automation/xl-run.sh runs at the next 02:00 slot.
# Set by the weekly review or the operator; the launcher clears it after the
# run, so a window runs once and is never silently repeated.
#
#   XL_CHUNK   — chunk id, used for the harness log name and the ledger row
#   XL_COMMAND — the command exactly as it would be typed after
#                scripts/testing/run_and_log.sh <chunk>
#
# Empty is the normal state — the tier is one run per 7 days — and the 02:00
# entry then exits quietly and costs nothing.
#
# Queued 2026-09-09 (operator direction): `ANS-4` step 2d, the matched-Ansys
# rung. Degree 2 is HFSS First Order, and AED's converged First Order run used
# 0.49–0.60 M tets / 3.1–3.8 M unknowns, so the finest rung here (0.005 →
# ≈ 474 k cells, ≈ 3.03 M unknowns, ≈ 226 GiB) approximates their actual setup
# rather than merely out-meshing ours. Full pre-registration, including the
# per-rung stop rule and the decision rule, is in the §7 `ANS-4` row.
#
# FEM_EM_SOLVER_PROGRESS=2 is on so the long degree-2 rungs report their
# factorization instead of going silent for tens of minutes (`OPS-43(d)`), and
# output is redirected to a gitignored file before being echoed back so a dead
# client cannot destroy the evidence (§5.1).

XL_CHUNK="ANS-4-step2d"
XL_COMMAND="docker compose --profile xl exec -T fem-em-solver-xl bash -lc 'cd /workspace && source /usr/local/bin/dolfinx-complex-mode && PYTHONPATH=/workspace/src FEM_EM_REQUIRE_COMPLEX=1 FEM_EM_SOLVER_PROGRESS=2 FEM_EM_ANS4_STEP2_RUNGSPEC=\"0.015:1 0.015:2 0.0075:2 0.005:2\" timeout -k 60 7200 mpiexec -n 16 python3 -m pytest tests/environment tests/validation/test_ans4_resolution_ladder.py -v -s --tb=short > /workspace/logs/ans4-step2d-raw.log 2>&1; rc=\$?; cat /workspace/logs/ans4-step2d-raw.log; echo \"[XL] memory.peak bytes:\"; cat /sys/fs/cgroup/memory.peak; echo \"[XL] rc=\$rc\"; exit \$rc'"
