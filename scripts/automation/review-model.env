# Review-model override for the scheduled plan reviews (daily + weekly).
#
# Sourced by scripts/automation/daily-review.sh and weekly-review.sh. It exists
# so a model swap is one dated edit rather than a hunt through two launchers,
# and — the point — so the swap **expires on its own**. Nobody has to remember
# to revert it, and no scheduled session can silently keep running on a model
# the operator only meant to borrow for a few days.
#
# Set 2026-09-09 (interactive session, operator request): the Fable credit pool
# is empty. The 2026-09-08 18:00 daily review died with "You're out of usage
# credits" (146-byte launcher log), and because the daily review is the only
# session that re-tops PROJECT_PLAN §9, the 21:00 / 22:30 / 00:00 implementer
# slots all drained and stopped with zero compute — one lost review costing
# three slots. Every implementer slot in the same window ran normally on
# claude-opus-5, so the outage is Fable-specific, not an account-wide stop.
# Opus at --effort high was smoke-tested through the CLI before this landed.
#
# To extend: move the UNTIL date. To end it early: delete this file, or blank
# REVIEW_MODEL_OVERRIDE. Either way the launchers fall back to the default
# below with no other edit.

REVIEW_MODEL_DEFAULT="claude-fable-5-1"

REVIEW_MODEL_OVERRIDE="claude-opus-5"

# Inclusive: the override applies through the end of this local day, so the
# first session on 2026-09-12 is back on Fable. Friday 2026-09-11 is the
# operator's stated horizon for the borrowed credits.
REVIEW_MODEL_OVERRIDE_UNTIL="2026-09-11"

REVIEW_MODEL_OVERRIDE_REASON="Fable credits exhausted 2026-09-08; operator request 2026-09-09"
