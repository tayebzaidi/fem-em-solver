import gmsh
print(gmsh.__file__)
gmsh.initialize()
print(\"gmsh\", gmsh.option.getString(\"General.Version\"))
exprs = {
  \"pow_caret\": \"x^2\",
  \"pow_star\": \"x*x\",
  \"sqrt_sci\": \"sqrt(x^2+1e-06)\",
  \"sci_plain\": \"x+1e-06\",
  \"sci_neg\": \"x+(-0.001)\",
  \"full\": \"sqrt((sqrt(x^2+y^2)-0.02)^2+(z-(-0.01))^2+(0.5*((sqrt(y^2)-0.005977525)+sqrt((sqrt(y^2)-0.005977525)^2)))^2+(0.5*(sqrt(x^2)-x))^2)\",
}
gmsh.model.add(\"probe\")
gmsh.model.occ.addBox(0,0,0,1,1,1); gmsh.model.occ.synchronize()
for name, e in exprs.items():
    f = gmsh.model.mesh.field.add(\"MathEval\")
    gmsh.model.mesh.field.setString(f, \"F\", e)
    gmsh.model.mesh.field.setAsBackgroundMesh(f)
    try:
        gmsh.model.mesh.generate(1)
        print(\"OK  \", name, e[:60])
    except Exception as ex:
        print(\"FAIL\", name, type(ex).__name__, ex)
    gmsh.model.mesh.clear()
gmsh.finalize()
"'

