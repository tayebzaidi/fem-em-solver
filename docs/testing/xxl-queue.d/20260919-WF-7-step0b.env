# One queued xxl window for scripts/automation/xl-run.sh xxl. Files in this
# directory run in lexical order, one per 02:00 window, and the launcher
# deletes each file after its window (run or failed). Name: <run-date>-<chunk>.env.
# Copied verbatim from docs/testing/xl-pending.md entry 1 (status QUEUED there).
XL_CHUNK="WF-7-step0b"
XL_COMMAND="docker compose --profile xxl exec -T fem-em-solver-xxl bash -lc 'cd /workspace && source /usr/local/bin/dolfinx-complex-mode && mkdir -p /workspace/logs && R=/workspace/logs/wf7-step0b-raw.log && { echo [orphans-before]; pgrep -c python3; true; } > \$R 2>&1; PYTHONPATH=/workspace/src FEM_EM_REQUIRE_COMPLEX=1 FEM_EM_SOLVER_PROGRESS=2 FEM_EM_WF7_DEGREE=1 timeout -k 60 1500 mpiexec -n 16 python3 scripts/probes/wf7_step0_f_human_cost.py >> \$R 2>&1; rc1=\$?; echo \"[WF-7 step0b] control degree-1 rc=\$rc1\" >> \$R; PYTHONPATH=/workspace/src FEM_EM_REQUIRE_COMPLEX=1 FEM_EM_SOLVER_PROGRESS=2 FEM_EM_WF7_DEGREE=2 timeout -k 60 27000 mpiexec -n 16 python3 scripts/probes/wf7_step0_f_human_cost.py >> \$R 2>&1; rc2=\$?; echo \"[WF-7 step0b] degree-2 rc=\$rc2\" >> \$R; { echo [orphans-after]; pgrep -c python3; true; } >> \$R 2>&1; echo \"[XL] memory.peak bytes:\" >> \$R; cat /sys/fs/cgroup/memory.peak >> \$R; rc=\$(( rc1 != 0 || rc2 != 0 )); echo \"[capture] rc=\$rc\" >> \$R; cat \$R; exit \$rc'"
